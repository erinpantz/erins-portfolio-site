# macOS: hidden Finder files
.DS_Store

# Dependencies: recreated by `npm install`
node_modules/

# Build output: recreated by `npm run build` (build/client is the finished site)
build/
dist/

# React Router: route types it generates while you work
.react-router/

# Local environment files: may hold secrets, never commit these
.env
.env.*

# Logs
*.log
